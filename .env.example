# SQLite file (path relative to the prisma/ folder → prisma/data/gather.db).
# Keep the .db file off git.
DATABASE_URL="file:./data/gather.db"
SESSION_SECRET="change-me-to-a-long-random-string"
CRON_SECRET="change-me-to-a-second-long-random-string"
# Exact public URL in production (no trailing slash). Local:
APP_ORIGIN="http://localhost:3000"
NODE_ENV="development"
# SCRAPE_LIVE=0
# SCRAPE_FIXTURES=0
