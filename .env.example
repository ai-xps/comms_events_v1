# Postgres (local or Railway). Example local:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gather?schema=public"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
SESSION_SECRET="change-me-to-a-long-random-string"
CRON_SECRET="change-me-to-a-second-long-random-string"
APP_ORIGIN="http://localhost:3000"
NODE_ENV="development"
# SCRAPE_LIVE=0
# SCRAPE_FIXTURES=0
